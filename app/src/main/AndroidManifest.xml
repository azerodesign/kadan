<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Kadan v1 permissions — each one is needed for a real feature, not a stub:
      POST_NOTIFICATIONS: show due reminders and the 15:15 PR nudge (runtime
        permission, requested in MainActivity on Android 13+).
      SCHEDULE_EXACT_ALARM: fire a reminder at its exact due time. On
        Android 12+ the user must also grant "Alarms & reminders" in system
        settings; ReminderScheduler.canScheduleExactAlarms() checks this and
        MainActivity opens that settings screen when it is denied. If it is
        denied, alarms fall back to inexact scheduling and the app must say
        so — it must never silently claim an exact reminder is set.
      RECEIVE_BOOT_COMPLETED: re-schedule due reminders + the PR nudge after
        a reboot (BootReceiver). Without it, every reminder would die on reboot.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".KadanApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kadan">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires a due-task reminder. Must be exported=false: only the app
             itself (via AlarmManager) may trigger it. -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />
        <!-- Fires the weekday 15:15 PR capture nudge and chains the next one. -->
        <receiver
            android:name=".notifications.PrNudgeReceiver"
            android:exported="false" />
        <!-- Re-schedules everything after a reboot. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
